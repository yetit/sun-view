---
import '@fontsource-variable/inter';
import 'maplibre-gl/dist/maplibre-gl.css';
import '../styles/global.css';
import Meta from '../components/Meta.astro';
---

<!doctype html>
<html lang="ru">
  <head>
    <Meta
      title="Sun & View"
      description="How many hours of sun reach each window, and can you see the sea? Click any building in Tivat, Kotor, Herceg Novi or Bergen: computed in your browser from open data. · Сколько часов солнца попадает в окна и видно ли море? Кликните любой дом в Тивате, Которе, Херцег-Нови или Бергене: расчёт в браузере по открытым данным."
      imageAlt="Sun & View: a 3D map of Tivat with buildings coloured by hours of winter sun · Sun & View: 3D-карта Тивата, дома окрашены по часам зимнего солнца"
    />
  </head>
  <body data-mode="sun" data-sheet="peek">
    <div id="map" class="map" role="region" aria-label="3D map"></div>
    <button class="rotate-hint" type="button" hidden></button>
    <div class="map-keys" aria-hidden="true" hidden></div>
    <div class="view-badge" hidden><span class="view-badge-stat"></span><button class="view-exit" type="button" data-i="viewClose"></button></div>
    <p class="sr-only sr-live" aria-live="polite"></p>
    <div class="map-fallback" role="alert" hidden><p class="map-fallback-text"></p><button class="map-fallback-retry" type="button" hidden></button></div>
    <div class="legend-box" hidden>
      <div class="legend-head"><b class="legend-title"></b><button class="legend-info" type="button" aria-describedby="legend-tip">i</button></div>
      <i class="legend-bar"></i>
      <span class="legend-ticks"><small class="legend-min"></small><small class="legend-mid"></small><small class="legend-max"></small></span>
      <small class="legend-cloud" hidden></small>
      <div class="legend-tip" id="legend-tip" role="tooltip"><p class="legend-note"></p><p class="legend-assumed"></p></div>
    </div>

    <aside class="panel">
      <button class="sheet-handle" type="button" data-i-aria="expand" aria-expanded="false"></button>

      <div class="timebar" role="group" aria-label="Time, season, map mode">
        <div class="chips">
          <button class="chip" type="button"></button><button class="chip" type="button"></button><button class="chip" type="button"></button><button class="chip" type="button"></button>
        </div>
        <label class="time"><button class="play" type="button" aria-pressed="false" data-i-title="play">▶</button><input class="hour" type="range" min="4" max="22" step="0.1667" value="11" data-i-aria="hourAria" /><span class="clock">11:00</span></label>
        <div class="modes" role="radiogroup" data-i-aria="map">
          <button class="mode-chip" type="button" role="radio" data-mode="normal"></button><button class="mode-chip" type="button" role="radio" data-mode="sun"></button><button class="mode-chip" type="button" role="radio" data-mode="sea"></button><button class="mode-chip" type="button" role="radio" data-mode="levels"></button>
          <select class="floor-mode" data-i-aria="heightAria"></select>
        </div>
        <span class="progress" aria-live="polite"></span>
      </div>
      <a class="open-full" href="./" target="_blank" rel="noopener" data-i="openFull"></a>

      <header class="brand">
        <h1>Sun &amp; View</h1>
        <select class="city" data-i-aria="city"></select>
        <a class="lang" href="?lang=en" hreflang="en">EN</a>
      </header>
      <p class="tagline" data-i="tagline"></p>
      <div class="search-wrap">
        <input class="search" type="search" data-i-ph="searchPh" data-i-aria="searchPh" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="search-results" />
        <div class="search-results" id="search-results" role="listbox" hidden></div>
      </div>

      <div class="loading" aria-live="polite">
        <ol class="stages"></ol>
        <div class="skeleton" aria-hidden="true"><i class="sk-title"></i><i class="sk-line"></i><i class="sk-line short"></i><div class="sk-cards"><i></i><i></i><i></i><i></i></div><i class="sk-ribbon"></i></div>
      </div>

      <div class="empty" hidden>
        <p class="lead" data-i="lead"></p>
        <p class="accuracy"></p>
        <div class="examples-box" hidden>
          <h2 class="sect" data-i="examples"></h2>
          <div class="examples"></div>
        </div>
        <p class="hint"></p>
      </div>

      <div class="result" hidden>
        <h2 class="b-name"></h2>
        <p class="b-meta"></p>
        <div class="trust"><b class="trust-level"></b><ul class="trust-reasons"></ul></div>
        <div class="assumed" hidden>
          <p data-i="assumedNote"></p>
          <p class="levels-impact" hidden></p>
          <div><input class="assumed-input" type="number" min="1" max="60" step="1" inputmode="numeric" data-i-aria="floor" /><button class="assumed-apply" type="button" data-i="assumedApply"></button></div>
          <a class="levels-help" href="https://github.com/yetit/sun-view#help-fill-in-floor-counts" target="_blank" rel="noopener" data-i="levelsHelp"></a>
        </div>
        <div class="floor-row"><label><span data-i="floor"></span> <select class="floor"></select></label><span class="eye"></span></div>
        <div class="sides-row"><span data-i="windows"></span><div class="sides"></div></div>
        <p class="now"></p>
        <p class="legend climate-line" data-i-title="climateTitle" hidden></p>
        <p class="summary"></p>

        <h3 data-i="matrixTitle"></h3>
        <div class="matrix"></div>
        <p class="legend" data-i="matrixLegend"></p>

        <h3 data-i="sunTitle"></h3>
        <div class="bre-box"></div>
        <div class="seasons"></div>
        <p class="legend seasons-note" data-i="seasonsNote" hidden></p>
        <div class="sky-chips" role="radiogroup" data-i-aria="skyLabel" hidden><button type="button" class="sky-chip" role="radio" data-cl="0" data-i="skyClear"></button><button type="button" class="sky-chip" role="radio" data-cl="1" data-i="skyCloudy" data-i-title="skyCloudyTitle"></button></div>
        <canvas class="ribbon" role="img" data-i-aria="ribbonLegend"></canvas>
        <p class="legend" data-i="ribbonLegend"></p>
        <p class="legend ribbon-cloud" data-i="ribbonCloudLegend" hidden></p>

        <h3 data-i="seaTitle"></h3>
        <div class="rose"></div>
        <p class="legend" data-i="roseLegend"></p>
        <div class="view-row"><button class="view-btn" type="button" aria-pressed="false" data-i="viewOpen"></button><span class="view-stat"></span></div>
        <canvas class="view-pano" role="img" hidden></canvas>
        <p class="legend view-legend" data-i="viewLegend" hidden></p>

        <div class="better-row"><button class="better-btn" type="button" data-i="betterBtn" data-i-title="betterTitle"></button><span class="better-out" aria-live="polite"></span></div>
        <div class="actions"><button class="pin-btn" type="button" data-i="addCompare"></button><button class="share-btn" type="button" data-i="downloadPng"></button></div>
      </div>

      <div class="compare" hidden>
        <h3 data-i="compare"></h3>
        <table><thead><tr></tr></thead><tbody class="compare-rows"></tbody></table>
        <p class="legend" data-i="compareLegend"></p>
      </div>

      <details class="about">
        <summary data-i="aboutTitle"></summary>
        <p data-i="about1"></p>
        <p class="about2"></p>
      </details>
    </aside>

    <script src="../scripts/main.ts"></script>
  </body>
</html>
