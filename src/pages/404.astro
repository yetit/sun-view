---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Meta from '../components/Meta.astro';
import { cities } from '../../cities.config.mjs';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ru">
  <head>
    <Meta
      title="Page not found — Sun & View"
      description="This page does not exist. Sun & View shows how many hours of sun reach each window and whether the sea is visible. · Такой страницы нет."
      imageAlt="Sun & View: a 3D map of Tivat with buildings coloured by hours of winter sun, and the app's title card"
    />
    <meta name="robots" content="noindex" />
    <script is:inline>
      const q = new URL(location.href).searchParams.get('lang');
      document.documentElement.lang = q === 'en' || q === 'ru' ? q : navigator.language.toLowerCase().startsWith('ru') ? 'ru' : 'en';
      if (document.documentElement.lang === 'ru') document.title = 'Страница не найдена — Sun & View';
    </script>
  </head>
  <body class="doc">
    <main class="doc-main">
      <h1><span lang="ru">Такой страницы нет</span><span lang="en">Page not found</span></h1>
      <p class="lead" lang="ru">Возможно, ссылка устарела или в ней опечатка. Солнце и вид на море можно посмотреть на карте.</p>
      <p class="lead" lang="en">The link may be out of date or mistyped. Sun hours and sea views are on the map.</p>
      <p>
        <a lang="ru" href={`${base}?lang=ru`}>← к карте</a><a lang="en" href={`${base}?lang=en`}>← back to the map</a>
        · <a lang="ru" href={`${base}method?lang=ru`}>как считается</a><a lang="en" href={`${base}method?lang=en`}>how it works</a>
      </p>
      <p>
        {cities.map((c, i) => <>{i > 0 && ' · '}<a href={`${base}?c=${c.id}`}><span lang="ru">{c.name}</span><span lang="en">{c.nameEn}</span></a></>)}
      </p>
    </main>
  </body>
</html>
